# CorePortal runtime configuration.
# Copy to /etc/default/coreportal (referenced by coreportal.service) or export
# these in your shell before running coreportal.py. All values are optional;
# the defaults shown here are what the app uses when a variable is unset.

# TCP port the app binds to.
PORT=8081

# URL prefix when served behind a reverse proxy (e.g. Apache at /coreportal).
# Leave empty when serving at the domain root.
COREPORTAL_BASE_PATH=/coreportal

# Timeout (seconds) for outbound market-data HTTP calls (Yahoo / stooq).
COREPORTAL_HTTP_TIMEOUT=8

# How long (seconds) a fetched current quote is cached before refetching.
COREPORTAL_QUOTE_TTL=60

# Seconds a database operation waits for a lock before erroring.
COREPORTAL_DB_TIMEOUT=10

# Maximum accepted form-POST body size, in bytes (default 256 KiB).
COREPORTAL_MAX_FORM_BYTES=262144

# Logging verbosity: DEBUG | INFO | WARNING | ERROR.
COREPORTAL_LOG_LEVEL=INFO

# Optional Alpha Vantage API key (enables the Alpha Vantage fallback paths).
ALPHAVANTAGE_API_KEY=
